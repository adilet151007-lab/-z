# Для локального запуска можно выполнить npm run setup.
TEACHER_PASSWORD=replace-with-your-long-password
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3000
# На Render ОБЯЗАТЕЛЬНО укажите Internal Database URL из PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Локально без DATABASE_URL используется этот файл:
STATE_FILE=./data/game-state.json

# Необязательный персональный доступ создателей: два разных кода по 26 символов.
# Значения задаются только в локальном .env или в Render, не в исходниках.
# CREATOR_ERNUR_CODE=
# CREATOR_ADILET_CODE=
# Shared local moderator access; SHA-256 of a random CQL- code, never the code itself.
# LOCAL_ADMIN_CODE_HASH=
